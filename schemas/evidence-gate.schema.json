{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KAFKA2306/com/schemas/evidence-gate.schema.json",
  "title": "KAFKA2306 Evidence Gate Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "revision", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gateItem"}
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {"$ref": "#/$defs/criterionItem"},
      "default": []
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "note": {"type": "string"}
      },
      "oneOf": [
        {"required": ["url"], "not": {"required": ["path"]}},
        {"required": ["path"], "not": {"required": ["url"]}}
      ]
    },
    "gateItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required", "status", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "status": {"enum": ["PASS", "FAIL", "UNVERIFIED"]},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "note": {"type": "string"}
      }
    },
    "criterionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "FAIL", "UNVERIFIED"]},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        },
        "note": {"type": "string"}
      }
    }
  }
}
